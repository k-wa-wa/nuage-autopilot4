{
  "name": "autopilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts run",
    "dev:dashboard": "bun --watch src/view/dev.tsx",
    "build": "bun build --compile --outfile dist/autopilot src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "check": "bun run typecheck && bun run lint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "yaml": "^2.6.0"
  }
}
